{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/buffet", "destination": "https://buffet.hugogaliana.com", "permanent": false },
    { "source": "/buffet/:path*", "destination": "https://buffet.hugogaliana.com/:path*", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|woff|woff2|jpg|jpeg|png|webp|avif|svg|ico|mp4)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/topnote/data/catalog.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
